{
    "version": 2,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20
    },
    "configurePresets": [
        {
            "name": "debug_build_without_bl",
            "displayName": "DEBUG build without bl for rev_1",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/dw",
            "cacheVariables": {
                "BOARD": "smart_switch_rev1/nrf54l15/cpuapp",
                "BOARD_ROOT": "${sourceDir}/../..",
                "DEBUG_BUILD": true,
                "CONF_FILE": "${sourceDir}/prj.conf",
                "PM_STATIC_YML_FILE": "${sourceDir}/pm_static_smart_switch.yml"
            }
        }
    ]
}
