config HW_STACK_PROTECTION
	default ARCH_HAS_STACK_PROTECTION

if BOARD_SMART_SWITCH_REV1_CPUAPP

config ROM_START_OFFSET
	default 0 if PARTITION_MANAGER_ENABLED
	default 0x800 if BOOTLOADER_MCUBOOT

endif # BOARD_SMART_SWITCH_REV1_CPUAPP

if BOARD_SMART_SWITCH_REV1_NRF54L15_CPUAPP

config BT_CTLR
	bool
	default BT

endif # BOARD_SMART_SWITCH_REV1_NRF54L15_CPUAPP

if BOARD_SMART_SWITCH_REV1_CPUAPP_NS

config BOARD_SMART_SWITCH_REV1
	select USE_DT_CODE_PARTITION if BOARD_SMART_SWITCH_REV1_CPUAPP_NS

config HAS_BT_CTLR
	bool
	default BT

config BUILD_WITH_TFM
	default y

endif # BOARD_SMART_SWITCH_REV1_CPUAPP_NS
